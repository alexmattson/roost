{
  "manifest_version": 3,
  "name": "Roost",
  "version": "1.5.0",
  "description": "Analytics, daily tracking and reconciliation for Sandpiper inventory and Quail point-of-sale.",
  "permissions": [
    "storage",
    "cookies",
    "scripting"
  ],
  "host_permissions": [
    "https://app.sandpiperhq.com/*",
    "https://vendor.quailhq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Roost",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}