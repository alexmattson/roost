{
  "manifest_version": 3,
  "name": "Sandpiper Analytics",
  "version": "1.2.0",
  "description": "A beautiful analytics dashboard for your Sandpiper inventory \u2014 sales, costs, margins, aging and potential profit.",
  "permissions": [
    "storage",
    "cookies",
    "scripting"
  ],
  "host_permissions": [
    "https://app.sandpiperhq.com/*",
    "https://vendor.quailhq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sandpiper Analytics",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}